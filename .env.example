# Copy to .env and fill in what you need. Every setting is optional.

# LLM provider: auto | openai | anthropic | none
# "auto" uses OpenAI if OPENAI_API_KEY is set, else Anthropic if
# ANTHROPIC_API_KEY is set, else the deterministic fallback.
BUNDLE_LLM_PROVIDER=auto
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Model name for whichever provider is used (set one you have access to), e.g. gpt-4.1-mini.
BUNDLE_LLM_MODEL=

# Optional: any OpenAI-compatible API instead of OpenAI itself. Set BUNDLE_LLM_PROVIDER=openai,
# put that service's key in OPENAI_API_KEY and its model name in BUNDLE_LLM_MODEL. Examples:
#   DeepSeek: https://api.deepseek.com
#   Local Ollama: http://localhost:11434/v1   (any non-empty OPENAI_API_KEY, e.g. "ollama")
BUNDLE_LLM_BASE_URL=
# auto | off | none | low | medium | high. "auto" sends "none" for gpt-6 models, which
# OpenAI requires for tool calling through Chat Completions, and nothing for older models.
BUNDLE_LLM_REASONING_EFFORT=auto

# SQLite file for the app (tests use an in-memory database).
BUNDLE_DATABASE_URL=sqlite:///./bundle.db

# Comma-separated email domains that count as campus emails.
BUNDLE_CAMPUS_DOMAINS=cornell.edu
